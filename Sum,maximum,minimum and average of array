import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc=new Scanner (System.in);
	    int n=sc.nextInt();
	    int[] a= new int [n];
	    int sum=0;
	    int avg=0;
	   
	   for(int i=0;i<n;i++)
	    {
	        a[i]=sc.nextInt();
	     }
        int max=a[0];
	    int min=a[0];
	    for(int i=0;i<n;i++)
	    { 
	        sum+=a[i];
	        avg=sum/n;
	        if(a[i]>max)
	        {
	            max=a[i];
	         }
	    
	        if(a[i]<min)
	        {
	            min=a[i];
	        }
	    }
	        System.out.println(sum);
	        System.out.println(avg);  
	        System.out.println(max);
	        System.out.println(min);
	}
}
