if __name__ == '__main__':
    students = []
    for _ in range(int(input())):
        name = input()
        score = float(input())
        students.append([name, score])

    # Get all unique scores and sort them to find the second lowest
    unique_scores = sorted(list(set([s[1] for s in students])))
    second_lowest_score = unique_scores[1]

    # Filter names that match the second lowest score
    result_names = [s[0] for s in students if s[1] == second_lowest_score]
    
    # Sort names alphabetically and print
    for name in sorted(result_names):
        print(name)
